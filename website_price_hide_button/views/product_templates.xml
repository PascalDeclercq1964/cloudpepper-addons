<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Hide price and add to cart button, show contact us instead -->
    <template id="product_hide" inherit_id="website_sale.product">
        <xpath expr="//input[@name='add_qty']" position="before">
        <t t-set="b2b_min_qty"
           t-value="6"/>
        </xpath>
        <xpath expr="//input[@name='add_qty']" position="attributes">
            <attribute name="t-att-data-min">b2b_min_qty</attribute>
            <attribute name="t-att-data-step">b2b_min_qty</attribute>
            <attribute name="t-att-value">b2b_min_qty</attribute>
        </xpath>
        <xpath expr="//input[@name='add_qty']" position="after">
            <p t-if="b2b_min_qty &gt; 1" class="text-muted small mt-1">
                Bestellen per <strong><t t-esc="b2b_min_qty"/></strong> stuks
            </p>
        </xpath>

        <!-- Add contact us button for public users -->
        <xpath expr="//div[@id='add_to_cart_wrap']" position="before">
            <t t-set="show_price" t-value="request.website.id == 1 or
                (request.website.id == 2 and request.env.user != request.website.user_id)"/>
            <div class="mt-2 mb-3" t-if="not show_price">
                <div class="alert alert-info mt-3">
                    <i class="fa fa-info-circle me-2"/>
                    <span>Please log in to see prices and purchase options.</span>
                </div>
                 <a href="/contactus" class="btn btn-primary btn-md">
                    <i class="fa fa-envelope me-2"/>
                    <span>Contact Us</span>
                </a>
            </div>
        </xpath>
        
        <!-- Hide add to cart button for public users -->
        <xpath expr="//div[@id='add_to_cart_wrap']" position="attributes">
            <attribute name="t-if">show_price</attribute>
        </xpath>
    </template>
    
    <!-- Hide product price in price widget -->
    <template id="product_price_hide" inherit_id="website_sale.product_price">
        <xpath expr="//div[@itemprop='offers']" position="before">
            <t t-set="show_price" t-value="request.website.id == 1 or
                (request.website.id == 2 and request.env.user != request.website.user_id)"/>
        </xpath>

        <xpath expr="//div[@itemprop='offers']" position="attributes">
            <attribute name="t-if">show_price</attribute>
        </xpath>
    </template>
    
    <!-- Hide cart icon in header for public users -->
    <template id="header_cart_link_hide" inherit_id="website_sale.header_cart_link">
        <xpath expr="//a[@href='/shop/cart']" position="before">
            <t t-set="show_price" t-value="request.website.id == 1 or
                (request.website.id == 2 and request.env.user != request.website.user_id)"/>
        </xpath>
        <xpath expr="//a[@href='/shop/cart']" position="attributes">
            <attribute name="t-if">show_price</attribute>
        </xpath>
    </template>
    
    <!-- Hide quantity selector for public users -->
    <template id="product_quantity_hide" inherit_id="website_sale.product_quantity">
        <xpath expr="//div[contains(@t-attf-class, 'css_quantity')]" position="attributes">
            <attribute name="t-if">request.website.id == 1 or
                (request.website.id == 2 and request.env.user != request.website.user_id)</attribute>
        </xpath>
    </template>
    
    <template id="assets_frontend" inherit_id="website.assets_frontend">
        <xpath expr="." position="inside">
            <script src="/my_module/static/src/js/quantity_step.js"/>
        </xpath>
    </template>
</odoo>
