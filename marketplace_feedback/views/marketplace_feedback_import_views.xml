<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="marketplace_feedback_import_view_list" model="ir.ui.view">
        <field name="name">marketplace.feedback.import.list</field>
        <field name="model">marketplace.feedback.import</field>
        <field name="arch" type="xml">
            <list string="Feedback-imports" decoration-info="state == 'draft'">
                <field name="create_date" string="Datum"/>
                <field name="name"/>
                <field name="marketplace"/>
                <field name="row_count"/>
                <field name="item_count"/>
                <field name="matched_count"/>
                <field name="new_field_count"/>
                <field name="value_rows_created"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="marketplace_feedback_import_view_form" model="ir.ui.view">
        <field name="name">marketplace.feedback.import.form</field>
        <field name="model">marketplace.feedback.import</field>
        <field name="arch" type="xml">
            <form string="Feedback importeren">
                <header>
                    <button name="action_process" type="object" string="Verwerken" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_process" type="object" string="Opnieuw verwerken"
                            invisible="state != 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                        In Channable: Amazon-kanaal › Resultaat › Feedback › <b>Download as CSV</b>.
                        Kies dat bestand hieronder en klik op Verwerken. De vorige feedback van deze
                        marktplaats wordt vervangen.
                    </div>
                    <group>
                        <group>
                            <field name="file" filename="name" readonly="state == 'done'"/>
                            <field name="name" invisible="1"/>
                            <field name="marketplace" readonly="state == 'done'"/>
                        </group>
                        <group invisible="state != 'done'">
                            <field name="processed_on"/>
                            <field name="row_count"/>
                            <field name="item_count"/>
                            <field name="matched_count"/>
                            <field name="new_field_count"/>
                            <field name="value_rows_created"/>
                        </group>
                    </group>
                    <div invisible="state != 'done' or new_field_count == 0" class="alert alert-warning" role="alert">
                        Er zijn nieuwe velden gemeld. Beslis per veld wat ermee moet gebeuren in
                        Configuratie › Marktplaatsen › Marktplaatsvelden (filter 'Te beslissen').
                    </div>
                    <separator string="Niet gevonden in Odoo" invisible="not unmatched"/>
                    <field name="unmatched" invisible="not unmatched" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_marketplace_feedback_import" model="ir.actions.act_window">
        <field name="name">Feedback importeren</field>
        <field name="res_model">marketplace.feedback.import</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nog geen import</p>
            <p>Download in Channable de Feedback-CSV van het Amazon-kanaal en importeer ze hier.</p>
        </field>
    </record>
</odoo>
