<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Hide product price in product grid -->
    <template id="products_item" inherit_id="website_sale.products_item">
        <xpath expr="//*[1]" position="before">
            <t t-set="show_price" t-value="True"/>
        </xpath>
        <xpath expr="//div[hasclass('oe_product_image')]" position="before">
            Show price #1: <t t-esc="show_price"/>
        </xpath>
        <!-- debuggin info-->
        <!-- 
        <xpath expr="//div[hasclass('oe_product_image')]" position="after">
            <t t-set="is_public" t-value="request.env.user == request.website.user_id"/>
            <div class="alert alert-info p-1 m-1" style="font-size: 0.7rem; border: 1px solid red;">
                <strong>Debug Info:</strong><br/>
                Is Public: <t t-esc="is_public"/><br/>
                <div class="product_price mt-1" t-if="is_public">
                    Is public: Ja
                </div>
                <div class="product_price mt-1" t-if="not is_public">
                    Is public: Nee
                </div>
                Website ID: <t t-esc="request.website.id"/>
                Website Name: <t t-esc="request.website.name"/>
            </div>
        </xpath>
        -->
        <!-- Replace the price div with a conditional version -->
        <xpath expr="//div[hasclass('product_price')]" position="attributes">
            <attribute name="t-if">show_price</attribute>
        </xpath>

        
        <!-- Add contact us link for public users -->
        <xpath expr="//div[hasclass('o_wsale_product_btn')]" position="inside">
            <div t-if="not show_price" class="mt-2">
                <a href="/contactus" class="btn btn-primary btn-sm w-100">
                    <i class="fa fa-envelope me-1"/>
                    <span>Contact Us</span>
                </a>
            </div>
        </xpath>
    </template>
    
    <!-- Hide price filter for public users -->
    <template id="filter_products_price_hide" inherit_id="website_sale.filter_products_price">
        <xpath expr="//div[@id='o_wsale_price_range_option']" position="replace">
            <t t-set="is_public" t-value="request.env.user == request.website.user_id"/>
            <div t-if="not is_public or request.website.id == 1" id="o_wsale_price_range_option" class="mt-3">
                <div class="d-flex align-items-center justify-content-between text-nowrap">
                    <span class="flex-grow-1 me-1">Min value</span>
                    <span class="flex-grow-1 ms-1 text-end">Max value</span>
                </div>
                <div class="d-flex align-items-center">
                    <input type="text" class="form-control" name="min_price" t-att-value="min_price or ''"/>
                    <span class="mx-1">-</span>
                    <input type="text" class="form-control" name="max_price" t-att-value="max_price or ''"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>



